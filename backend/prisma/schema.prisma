// ---------------------------------------------------------------------------
// Farah Water Company - PostgreSQL schema
// Money is always Decimal(12,2) -> Postgres `numeric` (NEVER float).
// Financial rows are voided/adjusted, never hard-deleted.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================== ENUMS ======================================

enum Role {
  ADMIN
  WORKER
}

enum WorkerType {
  WAREHOUSE_KEEPER // anbardar - anbar modulu ile isler, su noyluye gore say idare eder
  REGULAR // adi isci - yalniz oz balansina baxir, anbara girmez
}

enum DeliveryStatus {
  UNPAID
  PARTIAL
  PAID
  CANCELLED
}

enum DeliveryCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum InventoryTxType {
  INBOUND //        + warehouse        (new bottles received)
  ISSUE_TO_WORKER // + worker, - warehouse
  OUT_DELIVERY //   - worker           (bottles actually delivered & sold)
  RETURN_TO_STOCK // + warehouse, - worker
  DAMAGE //         - (from warehouse or worker) -> scrap
  LOSS //           - (from warehouse or worker) -> written off
  CORRECTION //     +/- manual adjustment by admin
}

enum BalanceScope {
  WAREHOUSE
  WORKER
}

enum DebtAdjustmentType {
  FORGIVE // debt waived  -> reduces what is owed
  DECREASE //           -> reduces what is owed
  INCREASE //           -> increases what is owed
}

/// What kind of water the bottles held. Filtered and spring are priced
/// separately, because the company buys and sells them at different rates.
enum WaterType {
  FILTERED
  SPRING
}

/// Where the bottles went. A home delivery has a free-text address; a company
/// delivery names a company and one of its offices, which fixes the price.
enum DestinationType {
  HOME
  COMPANY
}

/// Customer bottle-deposit ledger. `DEPOSIT_IN` means the company received a
/// deposit (and handed bottles over), `DEPOSIT_OUT` means money went back to
/// the customer as bottles were returned. `ADJUSTMENT` is a signed correction.
enum DepositTxType {
  DEPOSIT_IN
  DEPOSIT_OUT
  ADJUSTMENT
}

/// A worker asks the admin to change the sale price of one water type. Only an
/// approved request changes the price; the request rows themselves are history.
enum PriceRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExpenseCategory {
  FUEL
  SALARY
  MAINTENANCE
  RENT
  UTILITIES
  SUPPLIES
  TRANSPORT
  OTHER
}

// ============================== USERS ======================================

model User {
  id                 String      @id @default(uuid())
  fullName           String
  username           String      @unique
  phone              String?     @unique
  email              String?     @unique
  passwordHash       String
  role               Role        @default(WORKER)
  workerType         WorkerType? // yalniz WORKER rollunde anlamlidir: anbardar veya adi isci
  isActive           Boolean     @default(true)
  mustChangePassword Boolean     @default(false)

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens       RefreshToken[]
  deliveries          Delivery[]             @relation("DeliveryWorker")
  corrections         DeliveryCorrection[]   @relation("CorrectionRequestedBy")
  approvedCorrections DeliveryCorrection[]   @relation("CorrectionApprovedBy")
  recordedPay         Payment[]              @relation("PaymentRecordedBy")
  inventoryTx         InventoryTransaction[]
  /// Stock rows this user RECORDED. Distinct from `inventoryTx`, which are the
  /// rows where the stock belongs to them.
  recordedStock       InventoryTransaction[] @relation("InventoryTxCreatedBy")
  inventoryBal        InventoryBalance[]
  debtAdj             DebtAdjustment[]
  auditLogs           AuditLog[]
  notifications       Notification[]         @relation("NotificationUser")
  sentNotifications   Notification[]         @relation("NotificationActor")
  depositsCreated     CustomerDeposit[]      @relation("DepositCreatedBy")
  priceRequests       PriceChangeRequest[]   @relation("PriceRequestedBy")
  priceReviews        PriceChangeRequest[]   @relation("PriceRequestReviewedBy")
  priceChanges        PriceHistory[]         @relation("PriceChangedBy")
  pricesSet           WaterPrice[]           @relation("WaterPriceUpdatedBy")
  expenses            Expense[]

  @@index([role, isActive])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model LoginAttempt {
  id         String   @id @default(uuid())
  identifier String
  ip         String?
  success    Boolean
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@map("login_attempts")
}

// ============================= CUSTOMERS ===================================

model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  address   String
  note      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries Delivery[]
  payments   Payment[]
  deposits   CustomerDeposit[]

  @@index([name])
  @@index([address])
  @@map("customers")
}

// ============================= COMPANIES ====================================

/// A business the company delivers to. Its price per bottle is fixed by the
/// contract, split by water type, and is what makes a company delivery
/// self-pricing: the worker never types a price for one.
model Company {
  id            String   @id @default(uuid())
  name          String   @unique
  filteredPrice Decimal  @default(0) @db.Decimal(12, 2)
  springPrice   Decimal  @default(0) @db.Decimal(12, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  offices    Office[]
  deliveries Delivery[]

  @@map("companies")
}

/// A delivery point inside a company. "Bash ofis" is where the main desk is;
/// the rest are separate buildings with their own stock needs.
model Office {
  id        String   @id @default(uuid())
  companyId String
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deliveries Delivery[]

  @@unique([companyId, name])
  @@index([companyId, sortOrder])
  @@map("offices")
}

// ============================= DELIVERIES ==================================

/// A delivery is the financial root object. It owns exactly one debt and an
/// append-only list of payments. Totals are always recomputed server-side.
///
/// `paidAmount` is the SETTLED amount = sum(payments) + waived/decreased
/// adjustments - increased adjustments. It is deliberately NOT a revenue
/// figure: revenue is computed only from `payments` rows that are not voided,
/// so a waived debt can never be counted as cash received.
/// The database enforces `debtAmount = totalAmount - paidAmount`.
model Delivery {
  id             String  @id @default(uuid())
  idempotencyKey String  @unique
  customerId     String
  workerId       String
  address        String
  contactPhone   String?

  /// What was delivered and where it went.
  waterType       WaterType       @default(FILTERED)
  destinationType DestinationType @default(HOME)
  /// Set only when destinationType = COMPANY. ON DELETE RESTRICT: a delivery
  /// must never lose the office it was recorded against.
  companyId       String?
  officeId        String?

  bottleCount Int
  unitPrice   Decimal        @db.Decimal(12, 2)
  totalAmount Decimal        @db.Decimal(12, 2)
  paidAmount  Decimal        @default(0) @db.Decimal(12, 2)
  debtAmount  Decimal        @default(0) @db.Decimal(12, 2)
  status      DeliveryStatus @default(UNPAID)

  deliveredAt DateTime
  note        String?

  cancelledAt   DateTime?
  cancelledById String?
  cancelReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer    Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  worker      User                   @relation("DeliveryWorker", fields: [workerId], references: [id], onDelete: Restrict)
  company     Company?               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  office      Office?                @relation(fields: [officeId], references: [id], onDelete: Restrict)
  payments    Payment[]
  debtsAdj    DebtAdjustment[]
  corrections DeliveryCorrection[]
  inventory   InventoryTransaction[]

  @@index([workerId, deliveredAt])
  @@index([customerId, deliveredAt])
  @@index([status])
  @@index([deliveredAt])
  @@index([destinationType, deliveredAt])
  @@index([waterType, deliveredAt])
  @@index([officeId])
  @@map("deliveries")
}

// ============================== PAYMENTS ===================================

/// Append-only money-in ledger. Never updated except to VOID (soft delete).
/// `idempotencyKey` guarantees a payment can never be double recorded.
model Payment {
  id             String        @id @default(uuid())
  idempotencyKey String        @unique
  deliveryId     String
  customerId     String
  /// worker credited with this cash (the worker who performed the delivery)
  workerId       String
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod @default(CASH)
  paidAt         DateTime
  note           String?
  recordedById   String

  voidedAt   DateTime?
  voidedById String?
  voidReason String?

  createdAt DateTime @default(now())

  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  recordedBy User     @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([deliveryId])
  @@index([workerId, paidAt])
  @@index([paidAt])
  @@index([customerId])
  @@map("payments")
}

// ============================ DEBT ADJUSTMENTS =============================

/// Borc güzəşti / düzəlişi. Kept strictly separate from payments so that a
/// waived debt can never inflate reported revenue.
model DebtAdjustment {
  id          String             @id @default(uuid())
  deliveryId  String
  type        DebtAdjustmentType
  amount      Decimal            @db.Decimal(12, 2)
  reason      String
  createdById String
  createdAt   DateTime           @default(now())

  delivery  Delivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([deliveryId])
  @@map("debt_adjustments")
}

// ============================ CUSTOMER DEPOSITS ============================

/// Append-only bottle-deposit ledger per customer.
///
/// `amount` is a signed money delta (+ deposit received from the customer,
/// - deposit refunded to them) and `bottleCount` is the matching signed bottle
/// delta (+ bottles handed over, - bottles taken back). `balanceAfter` and
/// `bottleBalanceAfter` store the running totals at write time so the ledger is
/// readable without replaying every row.
///
/// Neither column is ever mixed into delivery revenue: a deposit is held money,
/// not income. Rows are never edited or deleted; a mistake is corrected by a
/// new `ADJUSTMENT` row. `customerId` is RESTRICT because the financial history
/// must survive even if the customer record is removed; in normal use customers
/// are deactivated (`isActive = false`), not deleted.
model CustomerDeposit {
  id                 String        @id @default(uuid())
  idempotencyKey     String        @unique
  customerId         String
  type               DepositTxType
  amount             Decimal       @db.Decimal(12, 2)
  bottleCount        Int
  balanceAfter       Decimal       @db.Decimal(12, 2)
  bottleBalanceAfter Int
  note               String?
  occurredAt         DateTime      @default(now())
  createdById        String
  createdAt          DateTime      @default(now())

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy User     @relation("DepositCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([customerId, occurredAt])
  @@index([occurredAt])
  @@map("customer_deposits")
}

// =============================== PRICES ====================================

/// The current sale price of one water type. Exactly one row per water type;
/// every change is appended to `PriceHistory`. Home deliveries and the web
/// panel read this value, company deliveries keep their contract price.
model WaterPrice {
  id            String    @id @default(uuid())
  waterType     WaterType @unique
  price         Decimal   @db.Decimal(12, 2)
  updatedById   String?
  effectiveFrom DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  updatedBy User? @relation("WaterPriceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("water_prices")
}

/// A worker's request to change a price. Pending until an admin approves or
/// rejects it; only approval touches `WaterPrice`. The request rows are kept as
/// history and are never deleted.
model PriceChangeRequest {
  id            String             @id @default(uuid())
  waterType     WaterType
  oldPrice      Decimal            @db.Decimal(12, 2)
  newPrice      Decimal            @db.Decimal(12, 2)
  reason        String
  status        PriceRequestStatus @default(PENDING)
  requestedById String
  requestedAt   DateTime           @default(now())
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String?

  requestedBy User  @relation("PriceRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy  User? @relation("PriceRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, requestedAt])
  @@index([waterType, requestedAt])
  @@map("price_change_requests")
}

/// Append-only price history. A row is written for an admin's direct change and
/// for every approved worker request (`requestId` points back to it).
model PriceHistory {
  id          String    @id @default(uuid())
  waterType   WaterType
  oldPrice    Decimal   @db.Decimal(12, 2)
  newPrice    Decimal   @db.Decimal(12, 2)
  source      String // ADMIN | PRICE_REQUEST
  requestId   String?
  note        String?
  changedById String
  occurredAt  DateTime  @default(now())

  changedBy User @relation("PriceChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([waterType, occurredAt])
  @@map("price_history")
}

// ============================== EXPENSES ===================================

/// Company spending. Expenses are what turn revenue into profit: revenue is
/// real payments, profit is revenue minus non-voided expenses. A wrong row is
/// voided (soft delete), never hard-deleted, so the history stays auditable.
model Expense {
  id             String          @id @default(uuid())
  idempotencyKey String          @unique
  category       ExpenseCategory @default(OTHER)
  /// Optional water-type allocation; null means a shared/overall expense.
  waterType      WaterType?
  amount         Decimal         @db.Decimal(12, 2)
  spentAt        DateTime        @default(now())
  note           String?
  createdById    String
  createdAt      DateTime        @default(now())

  voidedAt   DateTime?
  voidedById String?
  voidReason String?

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([spentAt])
  @@index([category])
  @@index([waterType, spentAt])
  @@map("expenses")
}

// ============================== INVENTORY ==================================

/// One row per stock bucket per water type: "WAREHOUSE:FILTERED",
/// "WAREHOUSE:SPRING", "WORKER:<userId>:FILTERED", "WORKER:<userId>:SPRING".
/// `quantity` is maintained with atomic `quantity = quantity + delta` UPDATEs
/// plus a DB CHECK (quantity >= 0) so stock can never go negative under load.
model InventoryBalance {
  key       String       @id
  scope     BalanceScope
  workerId  String?
  waterType WaterType
  quantity  Int          @default(0)
  updatedAt DateTime     @updatedAt

  worker User? @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([key, waterType])
  @@map("inventory_balances")
}

/// Append-only stock ledger. `reference` is the idempotency key that makes a
/// repeated delivery/inventory call a no-op instead of a double deduction.
model InventoryTransaction {
  id            String          @id @default(uuid())
  reference     String          @unique
  type          InventoryTxType
  bottleCount   Int
  /// signed delta applied to `balanceKey` (+1 in, -1 out)
  direction     Int
  balanceKey    String
  waterType     WaterType       @default(FILTERED)
  workerId      String?
  deliveryId    String?
  note          String?
  /// The balance of `balanceKey` immediately before and after this leg. Null
  /// only on rows written before these columns existed.
  beforeBalance Int?
  afterBalance  Int?
  occurredAt    DateTime        @default(now())
  createdById   String
  createdAt     DateTime        @default(now())

  worker    User?     @relation(fields: [workerId], references: [id], onDelete: Restrict)
  delivery  Delivery? @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  createdBy User      @relation("InventoryTxCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([balanceKey, occurredAt])
  @@index([type])
  @@index([waterType])
  @@index([workerId, occurredAt])
  @@index([deliveryId])
  @@map("inventory_transactions")
}

// ============================== AUDIT ======================================

/// İşçinin çatdırılmanın bidon sayısını dəyişməsi istəməsini izləyir.
/// Əvvəlcə "pending" olur, administrator rədd edir və ya təsdiqləyər.
/// Təsdiqləndikdə Delivery.bottleCount yenilenir və borc/ toplam avtomatik
/// yenidən hesablanır.
model DeliveryCorrection {
  id             String                   @id @default(uuid())
  deliveryId     String
  oldBottleCount Int
  newBottleCount Int
  reason         String
  status         DeliveryCorrectionStatus @default(PENDING)
  requestedById  String
  approvedById   String?
  requestedAt    DateTime                 @default(now())
  approvedAt     DateTime?

  delivery    Delivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  requestedBy User     @relation("CorrectionRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy  User?    @relation("CorrectionApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([deliveryId])
  @@index([status])
  @@index([requestedById, requestedAt])
  @@map("delivery_corrections")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorName  String?
  actorRole  String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  meta       Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

/// Administrator-un gormesi ucun anbar ve bidon emeliyyatlarinin bildirishi.
/// Her emeliyyatdan sonra yaradilir ve admin panelinde gosterilir.
///
/// `kind` separates the event families that share this inbox: `STOCK` (stock
/// movements, the original use), `DEPOSIT`, `PRICE`, `EXPENSE`, `BALANCE`.
/// The stock-specific columns are nullable so a deposit or price event can be
/// recorded without inventing bottle counts.
model Notification {
  id            String     @id @default(uuid())
  userId        String // bildirisin gonderelecegi administrator
  actorId       String // emeliyyati icra eden shakhs
  actorName     String
  actorRole     String?
  kind          String     @default("STOCK")
  action        String // INBOUND, ISSUE_TO_WORKER, ... | DEPOSIT_IN, PRICE_CHANGE, EXPENSE_ADDED, ...
  title         String?
  message       String?
  waterType     WaterType?
  bottleCount   Int?
  beforeBalance Int? // emeliyyatdan evvelki balans
  afterBalance  Int? // emeliyyatdan sonraki balans
  note          String?
  relatedId     String? // deliveryId veya inventoryTransactionId
  read          Boolean    @default(false)
  createdAt     DateTime   @default(now())

  user  User @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  // Restrict, not SetNull: a notification is history and must always name who
  // caused it. Users are deactivated rather than deleted, so this never blocks
  // normal operation, but it makes losing the author impossible by accident.
  actor User @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([read])
  @@map("notifications")
}

// ============================ APP SETTINGS =================================

model AppSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("app_settings")
}
