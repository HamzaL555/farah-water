# ---------------------------------------------------------------------------
# Farah Water Company - backend environment configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to git.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# --- Database (PostgreSQL) ------------------------------------------------
DATABASE_URL="postgresql://farah:CHANGE_ME@localhost:5432/farah?schema=public"

# --- JWT / session security ------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="CHANGE_ME_access_secret_min_32_chars_long_xxxxxxxxxxxx"
JWT_REFRESH_SECRET="CHANGE_ME_refresh_secret_min_32_chars_long_xxxxxxxxxxx"
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL_DAYS=30

# --- Password / brute force protection ------------------------------------
BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MIN=15

# --- Bootstrap admin (used by `npm run seed`) ------------------------------
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
INITIAL_ADMIN_FULL_NAME=Farah Su Şirkəti Admin
INITIAL_ADMIN_PHONE=+994500000000

# --- CORS ------------------------------------------------------------------
# Comma separated list of allowed origins. "*" only for local dev.
CORS_ORIGIN=*

# --- Business defaults -----------------------------------------------------
DEFAULT_BOTTLE_PRICE=2.00
CURRENCY=AZN
