# ---------------------------------------------------------------------------
# Caddy reverse proxy for the Farah API.
#
# Caddy obtains and renews a TLS certificate automatically (Let's Encrypt), so
# HTTPS is handled without manual certificate work. Point your domain's A record
# at this server, then start the proxy with:
#   docker compose --profile proxy up -d
# ---------------------------------------------------------------------------

api.example.com {
	encode zstd gzip

	# Reverse proxy to the backend container on its internal port.
	reverse_proxy farah-backend:4000 {
		# Keep the real client IP so rate limiting and audit logs are accurate.
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Report exports can be large; do not cut them off mid-stream.
	request_body {
		max_size 5MB
	}
	log {
		output file /var/log/caddy/access.log
		format json
	}
}
