# ---------------------------------------------------------------------------
# Docker Compose environment for the Farah stack.
# Copy to `.env` (this directory) and edit. NEVER commit the result.
# ---------------------------------------------------------------------------

POSTGRES_USER=farah
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=farah
# Host port. 5432 is used by the PostgreSQL default; change if it clashes.
POSTGRES_PORT=5432
BACKEND_PORT=4000

# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# Azerbaijan local time offset used for "today" / "this month" boundaries.
TZ_OFFSET_MINUTES=240

CORS_ORIGIN=*

# Bootstrap administrator (created by `npm run seed`).
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FULL_NAME=Farah Su Şirkəti Admin
INITIAL_ADMIN_PHONE=
